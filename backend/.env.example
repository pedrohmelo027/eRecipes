# Servidor
PORT=3333
CORS_ORIGIN=http://localhost:5173

# Banco de dados (MySQL local — o mesmo que você abre no DBeaver)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua-senha-do-root
DB_NAME=erecipes
# Banco usado pelos testes (é apagado e recriado a cada execução)
DB_NAME_TEST=erecipes_test

# Autenticação
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=8h

# Admin inicial (criado pelo seed — RN10)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@erecipes.com
ADMIN_SENHA=admin12345
