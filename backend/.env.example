# Servidor
PORT=3333
CORS_ORIGIN=http://localhost:5173

# Banco de dados — Supabase (PostgreSQL)
# Painel do Supabase → Connect → Session pooler. Quando preenchida, as variáveis DB_* abaixo são ignoradas
# (exceto nos testes, que nunca usam o Supabase).
DATABASE_URL=

# Banco de dados — PostgreSQL local (usado quando DATABASE_URL está vazia e pelos testes)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=erecipes
# Banco usado pelos testes (é apagado e recriado a cada execução)
DB_NAME_TEST=erecipes_test

# Supabase Storage (fotos das receitas) — Project Settings → API
# Sem SUPABASE_URL, as fotos são salvas em UPLOAD_DIR. NUNCA exponha a service_role no front-end.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=fotos-receitas

# Autenticação
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=8h

# Pasta onde as fotos são salvas quando o Supabase Storage não está configurado (padrão: ./uploads)
UPLOAD_DIR=uploads

# Admin inicial (criado pelo seed — RN10)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@erecipes.com
ADMIN_SENHA=admin12345
