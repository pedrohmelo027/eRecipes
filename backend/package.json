{
  "name": "erecipes-backend",
  "version": "1.0.0",
  "description": "API do eRecipes - site de receitas inteligente",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "db:criar": "tsx src/database/criarBanco.ts",
    "db:migrate": "tsx src/database/cli.ts migrate",
    "db:migrate:undo": "tsx src/database/cli.ts migrate:undo",
    "db:seed": "tsx src/database/cli.ts seed",
    "db:setup": "npm run db:criar && npm run db:migrate && npm run db:seed",
    "test": "jest --runInBand"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
